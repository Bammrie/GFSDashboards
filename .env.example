# Podium routing defaults for coverage requests
# Keep this as a single-line JSON string when copying into deployment platforms.
PODIUM_ACCOUNT_ROUTING_JSON={"__default":{"locationUid":"00000000-0000-0000-0000-000000000123","channel":"sms"},"Baycel Federal Credit Union":{"locationUid":"00000000-0000-0000-0000-000000000456","senderName":"Baycel Loans","channel":"sms","channelIdentifier":"+15551234567"}}

# Global fallback route if account matching misses
PODIUM_LOCATION_UID=00000000-0000-0000-0000-000000000123

# CU Loan Advisor backend proxy settings.
# Keep Ollama private; expose the dashboard/backend URL to users, not port 11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=cu-loan-advisor:latest
OLLAMA_TIMEOUT_MS=30000
